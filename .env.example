# OpenAI API Key
OPENAI_API_KEY=sk-...

# Database (db-metis on Railway — conversations, chat_messages, notifications)
# Production (Railway): use internal URL
# CONVERSATION_DATABASE_URL=postgresql://postgres:password@postgres-xxxx.railway.internal:5432/railway?sslmode=disable
# Local dev:
CONVERSATION_DATABASE_URL=postgresql://postgres:password@localhost:5432/metis

# Redis — currently unused (no code path consumes it)
# REDIS_URL=

# Pluto personal-finance API
# Production (Railway): use internal URL to avoid Nike gateway 403
# PLUTO_BASE_URL=http://pluto.railway.internal:8080/api/v1
# Local dev (via Nike gateway):
PLUTO_BASE_URL=https://api.olympkusai.com/pluto/api/v1

# Soter auth/identity service (for AI personalization preferences)
# Production (Railway): use internal URL
# SOTER_BASE_URL=http://soter.railway.internal:8080
# Local dev (via Nike gateway):
SOTER_BASE_URL=https://api.olympkusai.com/soter

# Hermes MCP server (for finance tools)
# Production (Railway): use internal URL
# HERMES_BASE_URL=http://hermes.railway.internal:8084/mcp
# Local dev (via Nike gateway):
HERMES_BASE_URL=https://api.olympkusai.com/hermes/mcp

# JWT validation (JWKS from Soter) — validates RS256 access tokens locally
# Production (Railway): use internal URL
# SOTER_JWKS_URL=http://soter.railway.internal:8080/.well-known/jwks.json
# Local dev (via Nike gateway):
SOTER_JWKS_URL=https://api.olympkusai.com/soter/.well-known/jwks.json
OIDC_ISSUER=https://auth.olympkusai.com
