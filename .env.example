# OpenAI API Key
OPENAI_API_KEY=sk-...

# Database (db-metis on Railway — market data, calculator tables, conversations, chat_messages, notifications)
DATABASE_DSN=postgresql://postgres:password@postgres-xxxx.railway.internal:5432/railway?sslmode=disable

# Conversation database (same db-metis Postgres — separate pool for conversations/chat_messages/notifications)
CONVERSATION_DATABASE_URL=postgresql://postgres:password@postgres-xxxx.railway.internal:5432/railway?sslmode=disable

# Redis — currently unused (no code path consumes it)
# REDIS_URL=

# Crypto Data API
API_BASE_URL=https://api.olympkusai.com/api/v1

# Apollo ML API
APOLLO_BASE_URL=http://apollo.internal:8000

# Pluto personal-finance API (via Nike gateway)
PLUTO_BASE_URL=https://api.olympkusai.com/pluto/api/v1
