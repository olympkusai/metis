# OpenAI API Key
OPENAI_API_KEY=sk-...

# Database (external k0s Postgres — market data cache, owned by another system)
DATABASE_URL=postgres://user:password@host:5432/k0s_prd?sslmode=require

# Metis's own database (db-metis on Railway) — conversations, chat_messages, notifications.
CONVERSATION_DATABASE_URL=postgres://metis:metis@localhost:5434/metis?sslmode=disable

# Redis — currently unused (no code path consumes it)
# REDIS_URL=

# Crypto Data API (k0s.app)
API_BASE_URL=https://api.k0s.app/api/v1

# Apollo ML API
APOLLO_BASE_URL=http://apollo.internal:8000

# Pluto personal-finance API (via Nike gateway)
PLUTO_BASE_URL=https://api.olympkusai.com/pluto/api/v1
